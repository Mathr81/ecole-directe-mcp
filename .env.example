# --- Commun ---
# Optionnel, sinon ~/.config/ecoledirecte-mcp/session.json
SESSION_PATH=
# Optionnel, sinon ~/.config/ecoledirecte-mcp/device-id
# Ne pas changer entre deux logins : École Directe lie l'exemption de QCM à cet identifiant.
DEVICE_ID_PATH=
# Optionnel, sinon ~/.local/share/ecoledirecte-mcp/downloads
DOWNLOAD_DIR=
# true pour désactiver mark_homework_done
# (par défaut : false en stdio, true en HTTP)
READ_ONLY=
# Millisecondes avant de rafraîchir la session par précaution, même sans erreur
# (par défaut : 900000 = 15 min — valeur conservatrice)
SESSION_MAX_AGE_MS=

# --- Transport HTTP (V2) uniquement ---
# Obligatoire pour `serve --http` : le serveur refuse de démarrer sans.
# Génère-le avec : openssl rand -hex 32
MCP_AUTH_TOKEN=
# Adresse d'écoute. En local : 127.0.0.1. En Docker, laisser le Dockerfile
# mettre 0.0.0.0 et publier le port sur l'IP Tailscale via TAILSCALE_IP.
MCP_HTTP_HOST=
MCP_HTTP_PORT=8787
# En-têtes Host acceptés (anti DNS rebinding), séparés par des virgules.
# Par défaut : l'adresse d'écoute. En Docker, mettre ce que les clients
# utilisent réellement dans l'URL.
MCP_ALLOWED_HOSTS=

# --- docker-compose uniquement ---
# IP Tailscale du VPS, donnée par `tailscale ip -4`. Le port n'est publié que
# sur celle-ci ; sans elle compose refuse de démarrer.
TAILSCALE_IP=
