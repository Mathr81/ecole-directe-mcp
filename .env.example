# --- Commun ---
# Optionnel, sinon ~/.config/ecoledirecte-mcp/session.json
SESSION_PATH=
# Optionnel, sinon ~/.config/ecoledirecte-mcp/device-id
# Ne pas changer entre deux logins : École Directe lie l'exemption de QCM à cet identifiant.
DEVICE_ID_PATH=
# Optionnel, sinon ~/.local/share/ecoledirecte-mcp/downloads
DOWNLOAD_DIR=
# true pour désactiver mark_homework_done
# (par défaut : false en stdio, true en HTTP)
READ_ONLY=
# Millisecondes avant de rafraîchir la session par précaution, même sans erreur
# (par défaut : 900000 = 15 min — valeur conservatrice)
SESSION_MAX_AGE_MS=

# --- Transport HTTP ---
# Il faut au moins UNE méthode d'authentification (jeton fixe et/ou OAuth),
# sinon le serveur refuse de démarrer.

# Jeton fixe, pour tes propres machines (tailnet).
# Génère-le avec : openssl rand -hex 32
MCP_AUTH_TOKEN=
# Adresse d'écoute. En local : 127.0.0.1. En Docker, laisser le Dockerfile
# mettre 0.0.0.0 et publier le port sur l'IP Tailscale via TAILSCALE_IP.
MCP_HTTP_HOST=
MCP_HTTP_PORT=8787
# En-têtes Host acceptés (anti DNS rebinding), séparés par des virgules.
# Par défaut : l'adresse d'écoute. En Docker, mettre ce que les clients
# utilisent réellement dans l'URL.
MCP_ALLOWED_HOSTS=

# --- OAuth : requis pour un connecteur personnalisé Claude.ai ---
# URL exacte que tu tapes dans Claude, chemin compris. Elle sert d'identifiant
# de ressource RFC 8707 et doit correspondre au métadonnées à la lettre.
MCP_PUBLIC_URL=
# Phrase secrète demandée sur l'écran de consentement. C'est ta seule
# preuve d'identité au moment d'autoriser Claude : prends-la longue.
MCP_OAUTH_PASSPHRASE=
# Où sont stockés clients et jetons OAuth (à côté de la session par défaut).
MCP_OAUTH_STORE_PATH=

# --- docker-compose uniquement ---
# Adresse sur laquelle publier le port. Obligatoire, pour ne jamais lier
# 0.0.0.0 par accident :
#   - déploiement tailnet : l'IP Tailscale du VPS (`tailscale ip -4`)
#   - derrière NPM installé sur l'hôte : 127.0.0.1
#   - derrière NPM en conteneur : utilise docker-compose.npm.yml, qui ne publie
#     aucun port et passe par le réseau Docker de NPM
PUBLISH_ADDRESS=
# Uniquement avec docker-compose.npm.yml : le réseau Docker de NPM.
NPM_NETWORK=
