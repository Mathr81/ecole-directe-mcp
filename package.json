{
  "name": "ecoledirecte-mcp",
  "version": "0.1.0",
  "description": "Serveur MCP pour École Directe (usage personnel)",
  "type": "module",
  "bin": {
    "ecoledirecte-mcp": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
